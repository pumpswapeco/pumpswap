{
  "name": "pumpswap-docs-ai-search",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered question-answering search for Pumpswap documentation",
  "main": "index.ts",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cd dist && zip -r ../server.zip .",
    "index": "tsx src/indexer.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^4.0.0",
    "express": "^5.1.0",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.0"
  }
}