# Pumpswap Docs AI Search - Backend Environment Variables
# Copy this file to .env and fill in values as needed.
# Do NOT commit .env to version control. Never put secrets in browser code.

# Google Gemini API key (server-side only, never in browser code)
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini API base URL
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Gemini embedding model
GEMINI_EMBED_MODEL=gemini-embedding-001

# Chat model
CHAT_MODEL=gemini-1.5-flash

# Path where the search index JSON will be stored (outside public static directories)
INDEX_PATH=public/index.json

# Server port
PORT=3000

# Optional secret for any future auth (change in production)
AUTH_SECRET=change-me-in-production

# Rate limiting: window in milliseconds
RATE_LIMIT_WINDOW_MS=900000

# Rate limiting: max requests per window
RATE_LIMIT_MAX_REQUESTS=60

# Max response body size in bytes
MAX_RESPONSE_SIZE_BYTES=52428800

# Allowed CORS origins
ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001

