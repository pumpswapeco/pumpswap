# Solana cluster: devnet | testnet | mainnet-beta
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Optional public RPC URL (no private API keys). Defaults to Solana public cluster URL.
# NEXT_PUBLIC_SOLANA_RPC_URL=

# Server-only RPC URL for future API routes / indexing (never exposed to the browser).
# SOLANA_RPC_URL=

# Deployed pumpswap-staking Anchor program id.
NEXT_PUBLIC_STAKING_PROGRAM_ID=BYc1mF65g1JNr44BWefhnhKdPLDWbxcdUoKxcoDeZMWs

# Default staking pool (pool PDA) shown in the user portal. Leave empty until a
# pool has been created on-chain; the portal then runs in simulation mode.
# NEXT_PUBLIC_DEFAULT_POOL_ADDRESS=
